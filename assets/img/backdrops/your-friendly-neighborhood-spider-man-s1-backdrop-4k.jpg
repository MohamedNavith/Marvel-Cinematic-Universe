
    <svg xmlns="http://www.w3.org/2000/svg" width="1280" height="720" viewBox="0 0 1280 720">
      <defs>
        <radialGradient id="grad" cx="50%" cy="40%" r="70%" fx="50%" fy="30%">
          <stop offset="0%" stop-color="#EF4444" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#05060A" stop-opacity="0.95" />
        </radialGradient>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255, 157, 46, 0.08)" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="#07080f"/>
      <rect width="100%" height="100%" fill="url(#grad)"/>
      <rect width="100%" height="100%" fill="url(#grid)"/>
      <circle cx="640" cy="320" r="320" fill="#EF4444" opacity="0.12" filter="blur(40px)"/>
      <text x="50%" y="340" font-family="'Oswald', 'Bebas Neue', 'Segoe UI', sans-serif" font-size="52" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="4">YOUR FRIENDLY NEIGHBORHOOD SPIDER-MAN (SEASON 1)</text>
      <text x="50%" y="395" font-family="'Inter', sans-serif" font-size="18" font-weight="600" fill="#EF4444" text-anchor="middle" letter-spacing="6">MARVEL CINEMATIC UNIVERSE</text>
      <text x="50%" y="430" font-family="'Inter', sans-serif" font-size="12" fill="rgba(255,255,255,0.4)" text-anchor="middle" letter-spacing="2">THE SACRED TIMELINE</text>
    </svg>
  