
    <svg xmlns="http://www.w3.org/2000/svg" width="600" height="900" viewBox="0 0 600 900">
      <defs>
        <radialGradient id="grad" cx="50%" cy="40%" r="70%" fx="50%" fy="30%">
          <stop offset="0%" stop-color="#DC2626" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#05060A" stop-opacity="0.95" />
        </radialGradient>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255, 157, 46, 0.08)" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="#07080f"/>
      <rect width="100%" height="100%" fill="url(#grad)"/>
      <rect width="100%" height="100%" fill="url(#grid)"/>
      <circle cx="300" cy="410" r="150" fill="#DC2626" opacity="0.12" filter="blur(40px)"/>
      <text x="50%" y="430" font-family="'Oswald', 'Bebas Neue', 'Segoe UI', sans-serif" font-size="36" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="4">DAREDEVIL: BORN AGAIN (SEASON 2)</text>
      <text x="50%" y="485" font-family="'Inter', sans-serif" font-size="14" font-weight="600" fill="#DC2626" text-anchor="middle" letter-spacing="6">MARVEL CINEMATIC UNIVERSE</text>
      <text x="50%" y="520" font-family="'Inter', sans-serif" font-size="12" fill="rgba(255,255,255,0.4)" text-anchor="middle" letter-spacing="2">THE SACRED TIMELINE</text>
    </svg>
  